# ============================================
# MEGATEC WEBSITE CONFIGURATION
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# --- SMTP Configuration ---
# Your Microsoft 365 / Office 365 SMTP settings
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your-email@megatec.co.il
SMTP_PASSWORD=your-app-password-here

# --- Email Recipients ---
# Company domain for validation
COMPANY_DOMAIN=megatec.co.il

# Default sender (must be a mailbox you have permission to send from)
MAIL_FROM_NAME=Megatec Website
MAIL_FROM_EMAIL=website@megatec.co.il

# Default recipient for general inquiries
MAIL_TO_DEFAULT=info@megatec.co.il

# Category-specific recipients (optional)
MAIL_TO_SALES=sales@megatec.co.il
MAIL_TO_TRAINING=training@megatec.co.il
MAIL_TO_SUPPORT=support@megatec.co.il

# --- Cloudflare Turnstile (Anti-spam) ---
# Get keys from: https://dash.cloudflare.com/turnstile
TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# --- Rate Limiting ---
# Maximum submissions per IP per hour
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Email Verification ---
# Enable double opt-in email confirmation
EMAIL_CONFIRMATION_ENABLED=false
EMAIL_CONFIRMATION_EXPIRY_MINUTES=30

# --- Security ---
# Secret key for CSRF tokens and signing
APP_SECRET_KEY=generate-a-random-32-character-string

# Debug mode (disable in production!)
DEBUG_MODE=false
